	<result property="mbrTelno" column="MBR_TELNO_LS" />
	<result property="mbrEmlAddr" column="MBR_EML_ADDR_LS" />
	<result property="mbrBasicAddr" column="MBR_BASIC_ADDR_LS" />
	<result property="mbrDetailAddr" column="MBR_DETAIL_ADDR_LS" />
